# Copy to backend/.env and adjust. Every value has a development default.

# SQLAlchemy database URL. SQLite needs no setup; MySQL example:
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/onlinekurs
DATABASE_URL=sqlite:///./onlinekurs.db

# Secret used to sign JWT tokens. Always override in production.
SECRET_KEY=change-me-to-a-long-random-string

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Directory for uploaded files (absolute or relative to backend/)
UPLOAD_DIR=./uploads

# Maximum video upload size in megabytes
MAX_UPLOAD_MB=500

# development | production (docs are exposed only in development)
ENVIRONMENT=development

# Public base URL of this API, used to build absolute upload URLs
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------
# OnlineKurs — muhit o'zgaruvchilari namunasi
# Backend uchun: backend/.env   (yoki bu faylni backend/.env sifatida nusxalang)
# Frontend uchun: frontend/.env
# ------------------------------------------------------------------

# ---------- Backend ----------
# Ma'lumotlar bazasi. Standart holatda SQLite (hech qanday sozlash kerak emas).
# MySQL uchun: mysql+pymysql://user:parol@localhost:3306/onlinekurs
DATABASE_URL=sqlite:///./onlinekurs.db

# JWT imzosi uchun maxfiy kalit. Ishlab chiqarish (production) uchun ALBATTA o'zgartiring:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENVIRONMENT=production rejimida quyidagi kabi namunaviy yoki 32 belgidan qisqa kalit bilan
# server ishga tushmaydi.
SECRET_KEY=change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# development | production
ENVIRONMENT=development

# Frontend manzillari (vergul bilan ajratilgan)
CORS_ORIGINS=http://localhost:5173

# Yuklangan fayllar uchun to'liq URL yasashda ishlatiladi
BACKEND_URL=http://localhost:8000

# Yuklangan fayllar papkasi (bo'sh qoldirilsa backend/uploads)
# UPLOAD_DIR=
MAX_UPLOAD_MB=500

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
